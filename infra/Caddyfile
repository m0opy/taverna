{$DOMAIN:localhost} {
  encode zstd gzip

  handle /api/* {
    reverse_proxy api:3000
  }

  @immutableAssets path_regexp immutableAssets \.(?:css|js|mjs|png|jpg|jpeg|webp|avif|svg|woff2?)$
  header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

  handle {
    root * /srv
    try_files {path} /index.html
    header /index.html Cache-Control "no-cache"
    file_server
  }

  log {
    output stdout
    format json
  }
}
