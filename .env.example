NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://taverna:taverna@localhost:5432/taverna?schema=public
POSTGRES_DB=taverna
POSTGRES_USER=taverna
POSTGRES_PASSWORD=taverna
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
ALLOW_INSECURE_SESSION_COOKIES=false
APP_VERSION=dev
ENABLE_DEMO_SEED=false
DEMO_EMAIL=demo@tavern.app
DEMO_PASSWORD=replace-before-enabling-demo-seed

# Production images (required by infra/compose.prod.yml)
API_IMAGE=ghcr.io/your-org/taverna-api:latest
WEB_IMAGE=ghcr.io/your-org/taverna-web:latest
