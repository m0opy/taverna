{
  "name": "taverna",
  "version": "0.1.0",
  "private": true,
  "description": "Хаб для совместного ведения ДнД-кампаний",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13 <27",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @taverna/api db:generate",
    "db:migrate": "pnpm --filter @taverna/api db:migrate",
    "db:seed": "pnpm --filter @taverna/api db:seed"
  }
}
